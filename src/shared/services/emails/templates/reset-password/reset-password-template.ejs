<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Changed</title>
  <style>
    /* Reset styles */
    body { margin: 0; padding: 0; background-color: #f4f6f8; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
    table { border-spacing: 0; width: 100%; }
    td { padding: 0; }
    img { border: 0; }

    /* Main container */
    .wrapper { width: 100%; table-layout: fixed; background-color: #f4f6f8; padding-bottom: 40px; }
    .main-table { background-color: #ffffff; margin: 0 auto; width: 100%; max-width: 600px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); overflow: hidden; }

    /* Content styles */
    .header { background-color: #50b5ff; padding: 25px 0; text-align: center; }
    .content { padding: 40px 30px; }

    .success-icon { font-size: 40px; color: #50b5ff; margin-bottom: 10px; display: block; text-align: center;}

    /* Info Box Styles */
    .info-box {
      background-color: #f9f9f9;
      border: 1px solid #eeeeee;
      border-radius: 6px;
      padding: 15px;
      margin: 20px 0;
    }

    .info-row { padding: 8px 0; border-bottom: 1px solid #eeeeee; }
    .info-row:last-child { border-bottom: none; }
    .info-label { font-weight: bold; color: #555555; font-size: 14px; width: 100px; }
    .info-value { color: #333333; font-size: 14px; }

    .text-primary { color: #333333; font-size: 16px; line-height: 24px; margin-bottom: 20px; text-align: center;}
    .warning { color: #e74c3c; font-size: 13px; line-height: 20px; text-align: center; margin-top: 20px;}
    .footer { text-align: center; color: #999999; font-size: 12px; margin-top: 30px;}
  </style>
</head>
<body>

  <center class="wrapper">
    <table class="main-table">

      <tr>
        <td class="header">
           <img src="<%= image_url %>" width="150" alt="Chatty App" style="display: block; margin: 0 auto;">
        </td>
      </tr>

      <tr>
        <td class="content">

          <div class="success-icon">✓</div>
          <h2 style="color: #333333; margin-top: 0; text-align: center;">Password Changed!</h2>

          <p class="text-primary">
            Hi <strong><%= username %></strong>,<br>
            Your password for <strong>Chatty App</strong> was successfully changed.
          </p>

          <div class="info-box">
            <table class="info-table">
              <tr>
                <td class="info-row">
                  <span class="info-label">Email:</span>
                  <span class="info-value"><%= email %></span>
                </td>
              </tr>
              <tr>
                <td class="info-row">
                  <span class="info-label">IP Address:</span>
                  <span class="info-value"><%= ipaddress %></span>
                </td>
              </tr>
              <tr>
                <td class="info-row">
                  <span class="info-label">Date:</span>
                  <span class="info-value"><%= date %></span>
                </td>
              </tr>
            </table>
          </div>

          <p class="warning">
            🚨 <strong>Security Alert:</strong> If you did not make this change, please contact our support team immediately to secure your account.
          </p>

          <hr style="border: 0; border-top: 1px solid #eeeeee; margin: 30px 0;">

          <div class="footer">
            Chatty App Team
          </div>

        </td>
      </tr>

    </table>
  </center>

</body>
</html>
