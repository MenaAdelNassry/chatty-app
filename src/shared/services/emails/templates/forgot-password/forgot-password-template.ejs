<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Reset OTP</title>
  <style>
    /* Reset styles */
    body { margin: 0; padding: 0; background-color: #f4f6f8; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }
    table { border-spacing: 0; }
    td { padding: 0; }
    img { border: 0; }

    /* Main container */
    .wrapper { width: 100%; table-layout: fixed; background-color: #f4f6f8; padding-bottom: 40px; }
    .main-table { background-color: #ffffff; margin: 0 auto; width: 100%; max-width: 600px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); overflow: hidden; }

    /* Content styles */
    .header { background-color: #50b5ff; padding: 30px 0; text-align: center; }
    .content { padding: 40px 30px; text-align: center; }

    .otp-box {
      background-color: #f0f8ff;
      border: 2px dashed #50b5ff;
      border-radius: 8px;
      padding: 15px;
      margin: 25px 0;
      display: inline-block;
    }

    .otp-code {
      font-size: 32px;
      font-weight: bold;
      color: #333333;
      letter-spacing: 8px;
      font-family: 'Courier New', Courier, monospace; 
    }

    .text-primary { color: #333333; font-size: 16px; line-height: 24px; margin-bottom: 20px; }
    .text-secondary { color: #888888; font-size: 14px; line-height: 20px; margin-top: 30px; }
    .warning { color: #e74c3c; font-weight: bold; font-size: 13px; }
  </style>
</head>
<body>

  <center class="wrapper">
    <table class="main-table" width="100%">

      <tr>
        <td class="header">
           <img src="<%= image_url %>" width="150" alt="Chatty App" style="display: block; margin: 0 auto;">
        </td>
      </tr>

      <tr>
        <td class="content">

          <h2 style="color: #333333; margin-top: 0;">Password Reset</h2>

          <p class="text-primary">
            Hello <strong><%= username %></strong>,<br>
            We received a request to reset your password. Use the code below to proceed.
          </p>

          <div class="otp-box">
            <span class="otp-code"><%= otp %></span>
          </div>

          <p class="text-primary">
            This code will expire in <strong><%= validity %></strong>.
          </p>

          <p class="warning">
            If you did not request this, please ignore this email and do not share this code with anyone.
          </p>

          <hr style="border: 0; border-top: 1px solid #eeeeee; margin: 30px 0;">

          <p class="text-secondary">
            Thank you,<br>
            <strong>Chatty App Team</strong>
          </p>

        </td>
      </tr>

    </table>
  </center>

</body>
</html>
