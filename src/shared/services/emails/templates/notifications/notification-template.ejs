<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Notification</title>
    <style>
      /* Reset styles */
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f6f8;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      }
      table {
        border-spacing: 0;
        width: 100%;
      }
      td {
        padding: 0;
      }
      img {
        border: 0;
      }

      /* Main container */
      .wrapper {
        width: 100%;
        table-layout: fixed;
        background-color: #f4f6f8;
        padding-bottom: 40px;
      }
      .main-table {
        background-color: #ffffff;
        margin: 0 auto;
        width: 100%;
        max-width: 600px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }

      /* Header */
      .header {
        background-color: #50b5ff;
        padding: 25px 0;
        text-align: center;
      }

      /* Content */
      .content {
        padding: 40px 30px;
        text-align: center;
      }

      .notification-icon {
        font-size: 30px;
        margin-bottom: 15px;
        display: block;
      }

      .notification-box {
        background-color: #f0f8ff;
        border-left: 4px solid #50b5ff;
        padding: 20px;
        margin: 20px 0;
        text-align: left;
        border-radius: 4px;
      }

      .message-text {
        color: #333333;
        font-size: 16px;
        line-height: 24px;
        font-weight: 500;
      }

      .btn {
        display: inline-block;
        padding: 12px 24px;
        background-color: #50b5ff;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
        font-size: 14px;
        margin-top: 20px;
      }

      .text-greeting {
        color: #555555;
        font-size: 16px;
        margin-bottom: 10px;
        text-align: left;
      }
      .footer {
        text-align: center;
        color: #999999;
        font-size: 12px;
        margin-top: 30px;
      }
    </style>
  </head>
  <body>
    <center class="wrapper">
      <table class="main-table">
        <tr>
          <td class="header">
            <img src="<%= image_url %>" width="150" alt="Chatty App" style="display: block; margin: 0 auto" />
          </td>
        </tr>

        <tr>
          <td class="content">
            <p class="text-greeting">Hello <strong><%= username %></strong>,</p>

            <h2 style="color: #333333; margin: 0 0 10px 0; text-align: left"><%= header %></h2>

            <div class="notification-box">
              <div class="message-text"><%= message %></div>
            </div>

            <a href="http://localhost:3000" class="btn">View on Chatty</a>

            <div class="footer">You received this email because you have notifications enabled on Chatty App.</div>
          </td>
        </tr>
      </table>
    </center>
  </body>
</html>
